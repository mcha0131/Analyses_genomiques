# ===== 0. Analyse préliminaire =====

data <- read.csv("DENV_genomic_analyses_simulated_dataset_2-1.csv", stringsAsFactors = FALSE)


data$collection_date <- as.Date(data$collection_date)


homme <- data[grepl("^H", data$ID), ]


moustique <- data[grepl("^M", data$ID), ]


homme <- homme[order(homme$location, homme$collection_date), ]
moustique <- moustique[order(moustique$location, moustique$collection_date), ]


write.csv(homme, "Homme.csv", row.names = FALSE)
write.csv(moustique, "Moustique.csv", row.names = FALSE)



if (!require(sp)) install.packages("sp") 
